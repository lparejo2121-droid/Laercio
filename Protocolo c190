# 8. Transforma o resultado binário em string para juntar ao payload
payload_dados = f"{block}-{and_result}"

# 9. Converte a string em bytes (UTF-8) e calcula o hash SHA-256 real
sha256_hash = hashlib.sha256(payload_dados.encode('utf-8')).hexdigest()

