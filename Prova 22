## 2. Assinatura do Bloco Local

```python
import hashlib
import json
from datetime import datetime


def registrar_prova_22(usuario: str, bloco_hex: str):
    payload = {
        "usuario": usuario,
        "prova": "PROVA_22",
        "ancoragem": "Praia Grande/SP",
        "bloco_hex": bloco_hex,
        "timestamp": datetime.utcnow().isoformat(),
        "status": "VERIFIED",
    }

    payload_bytes = json.dumps(payload, sort_keys=True).encode("utf-8")
    hash_assinatura = hashlib.sha256(payload_bytes).hexdigest()

    return {"payload": payload, "hash": hash_assinatura}


